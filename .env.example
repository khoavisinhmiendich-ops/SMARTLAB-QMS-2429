# Lưu trữ dữ liệu nghiệp vụ (Supabase)
# URL dạng https://<project-ref>.supabase.co  (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Trợ lý AI có tra cứu Internet (chỉ đặt ở server/Vercel, KHÔNG dùng NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# Kết nối dự phòng (tùy chọn): khi Gemini hết hạn mức, hệ thống tự chuyển sang kết nối có key bên dưới.
# Cấu hình thứ tự/model của các kết nối trong tệp ai.config.ts.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Server-only key for reliable QMS autosave (never prefix with NEXT_PUBLIC_ or expose in client code)
# Dán khóa service_role thật, hoặc XÓA dòng này nếu không dùng (đừng để giá trị mẫu)
SUPABASE_SERVICE_ROLE_KEY=

# Bảo vệ truy cập QMS (đặt trong .env.local và Vercel; không commit mật khẩu)
QMS_LOGIN_USERNAME=admin
QMS_LOGIN_PASSWORD=
QMS_AUTH_SECRET=

# Passkey mở thư mục "Các BM khác" (tùy chọn). Không đặt thì dùng passkey mặc định đã băm trong mã nguồn.
QMS_BM_PASSKEY=Vsmd@2026
# Nơi sao lưu bản phụ dữ liệu nhập (tùy chọn). Mặc định: thư mục ../qms-backup-2429 (ngoài dự án) và .data/backup
QMS_BACKUP_DIR=
