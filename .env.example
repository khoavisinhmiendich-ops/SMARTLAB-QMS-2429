# Lưu trữ dữ liệu nghiệp vụ (Supabase)
# URL dạng https://<project-ref>.supabase.co  (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# Trợ lý AI có tra cứu Internet (chỉ đặt ở server/Vercel, KHÔNG dùng NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# Kết nối dự phòng (tùy chọn): khi Gemini hết hạn mức, hệ thống tự chuyển sang kết nối có key bên dưới.
# Cấu hình thứ tự/model của các kết nối trong tệp ai.config.ts.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Server-only key for reliable QMS autosave (never prefix with NEXT_PUBLIC_ or expose in client code)
# Dán khóa service_role thật, hoặc XÓA dòng này nếu không dùng (đừng để giá trị mẫu)
SUPABASE_SERVICE_ROLE_KEY=

# Bảo vệ truy cập QMS (đặt trong .env.local và Vercel; không commit mật khẩu)
QMS_LOGIN_USERNAME=admin
QMS_LOGIN_PASSWORD=doi_thanh_mat_khau_manh_cua_ban
QMS_AUTH_SECRET=thay_bang_chuoi_ngau_nhien_dai_tren_32_ky_tu

# Passkey mở thư mục "Các BM khác" (tùy chọn). Không đặt thì dùng passkey mặc định đã băm trong mã nguồn.
QMS_BM_PASSKEY=
# Nơi sao lưu bản phụ dữ liệu nhập (tùy chọn). Mặc định: thư mục ../qms-backup-2429 (ngoài dự án) và .data/backup
QMS_BACKUP_DIR=


# ===== Sao lưu Google Drive (tùy chọn) =====
# Tạo ở Google Cloud Console: bật "Google Drive API" -> OAuth consent screen (đặt "In production") -> Credentials -> OAuth client ID loại "Web application".
# Authorized redirect URI: https://<tên-miền-của-bạn>/api/drive/callback  (và http://localhost:3000/api/drive/callback khi chạy thử)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chỉ đặt nếu máy chủ không ghi được ổ đĩa (vd. Vercel): dán mã hiện ra sau khi bấm "Kết nối Google Drive" ở trang /backup.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Tên thư mục trên Drive (mặc định SMARTLAB-QMS-2429-Backup) và số ngày không sửa thì tự chuyển lên Drive (mặc định 60, từ 30 đến 180).
GOOGLE_DRIVE_FOLDER_NAME=
DRIVE_ARCHIVE_AFTER_DAYS=60
# Địa chỉ gọi lại nếu ứng dụng chạy sau proxy và địa chỉ tự nhận sai (tùy chọn).
GOOGLE_REDIRECT_URI=
# Lịch tự động trên Vercel (vercel.json): đặt chuỗi bí mật dài >= 16 ký tự. Máy chủ Node chạy liên tục tự kiểm tra mỗi 6 giờ; tắt bằng DRIVE_AUTO_ARCHIVE=0.
CRON_SECRET=
